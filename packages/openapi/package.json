{
  "name": "@visionpilot/zen-openapi",
  "version": "0.1.0-alpha.1",
  "description": "Zen OpenAPI: the application graph as an OAS 3.1 document, $ref deduplication, breaking-change detection and a dependency-free viewer.",
  "keywords": [
    "openapi",
    "openapi-3.1",
    "swagger",
    "api-docs",
    "json-schema",
    "zen"
  ],
  "homepage": "https://github.com/VisionPilot/Zen.js/tree/main/packages/openapi#readme",
  "bugs": {
    "url": "https://github.com/VisionPilot/Zen.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VisionPilot/Zen.js.git",
    "directory": "packages/openapi"
  },
  "license": "MIT",
  "author": {
    "name": "VisionPilot",
    "url": "https://github.com/VisionPilot"
  },
  "contributors": [
    {
      "name": "Eren Sümer",
      "url": "https://github.com/ErenSumer"
    }
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@visionpilot/zen-core": "0.1.0-alpha.1"
  },
  "peerDependencies": {
    "typescript": ">=5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}

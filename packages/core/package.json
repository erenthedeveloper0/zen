{
  "name": "@erenthedeveloper0/zen-core",
  "version": "0.1.0-alpha.3",
  "description": "Zen core: registries, compilers, runtime, context, errors and the response engine. Zero runtime dependencies.",
  "keywords": [
    "web",
    "framework",
    "http",
    "server",
    "typescript",
    "compiler",
    "standard-schema",
    "zen"
  ],
  "homepage": "https://github.com/erenthedeveloper0/zen/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/erenthedeveloper0/zen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erenthedeveloper0/zen.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": {
    "name": "Eren Sümer",
    "url": "https://github.com/erenthedeveloper0"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {},
  "peerDependencies": {
    "typescript": ">=5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }

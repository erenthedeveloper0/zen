# Copy to `.env` and edit. A real service must not read this file at runtime —
# see the note in `src/config/sources.ts`. It is the lowest layer here only so
# the example runs from a fresh clone.

NODE_ENV=development
PORT=3000

# The CORS allowlist, comma separated. These two are a Vite dev server and this
# process itself, which is what a local front end actually needs.
#
# Change one of them and re-run `npm run explain -w @visionpilot/zen-example-middleware`:
# the provenance table shows the new value, this file, and the line it is on.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Requests per minute, per client.
RATE_LIMIT=60

# Marked `format: 'password'` in the schema, so it is redacted in the boot log,
# in `explainConfig`, in the AppGraph snapshot and in `JSON.stringify(config)`.
ADMIN_TOKEN=local-development-token-not-a-real-secret

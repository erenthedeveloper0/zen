# Copy to `.env` and edit. `.env` is gitignored; this file is not.
#
# The example reads this file as the *lowest*-precedence layer so that it runs
# from a fresh clone — see `src/config/sources.ts` for why a real service must
# not do that.

NODE_ENV=development
PORT=3000

# Marked `format: 'password'` in the schema, so it is redacted everywhere
# except where something asks for it by name.
DATABASE_URL=postgres://zen:zen@localhost:5432/zen_example

# Read by the mailer plugin, which declares that in its manifest — so a missing
# value names the plugin that will not work.
SMTP_URL=smtp://localhost:1025

LOG_LEVEL=info
PAGE_SIZE=25
